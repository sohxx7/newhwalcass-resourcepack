{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "slim",
        "model": {
          "type": "minecraft:special",
          "base": "minecraft:item/flowery_special/slim/torso",
          "model": {
            "type": "minecraft:player_head"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "minecraft:item/flowery_special/torso",
      "model": {
        "type": "minecraft:player_head"
      }
    }
  }
}
